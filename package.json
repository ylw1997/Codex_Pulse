{
  "name": "codex-pulse",
  "displayName": "Codex Pulse",
  "description": "%extension.description%",
  "version": "1.0.1",
  "publisher": "ylw",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ylwgg/codex-pulse.git"
  },
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "quota",
    "usage",
    "statusbar",
    "openai"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexPulse.refresh",
        "title": "%command.refresh.title%"
      },
      {
        "command": "codexPulse.showDiagnostics",
        "title": "%command.showDiagnostics.title%"
      }
    ],
    "configuration": {
      "title": "Codex Pulse",
      "properties": {
        "codexPulse.codexCommand": {
          "type": "string",
          "default": "",
          "description": "%configuration.codexCommand.description%"
        },
        "codexPulse.codexHome": {
          "type": "string",
          "default": "",
          "description": "%configuration.codexHome.description%"
        },
        "codexPulse.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "description": "%configuration.refreshIntervalSeconds.description%"
        },
        "codexPulse.displayMode": {
          "type": "string",
          "default": "remaining",
          "enum": [
            "remaining",
            "used"
          ],
          "description": "%configuration.displayMode.description%"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "publish:marketplace": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies",
    "publish:all": "vsce publish --no-dependencies && ovsx publish --no-dependencies"
  }
}
